# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python
*.pyi text diff=python
*.pyw text
*.cfg text
*.toml text
*.ini text
*.txt text
*.md text
*.rst text

# JavaScript/TypeScript
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.html text
*.css text

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.eot binary
*.ttf binary
*.woff binary
*.woff2 binary
