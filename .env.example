# ── Required ──
# Get a free API key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Security ──
# Set a strong password for the admin dashboard
ADMIN_PASSWORD=your_admin_password_here

# ── LLM Configuration (optional) ──
# Model for general agents (support, inventory, order, pricing)
LLM_MODEL=llama-3.3-70b-versatile

# Model for fraud analysis (can use a different model)
FRAUD_LLM_MODEL=llama-3.3-70b-versatile

# Lower = more deterministic, Higher = more creative (0.0 - 1.0)
LLM_TEMPERATURE=0.3

# ── Database (optional) ──
# Default: sqlite:///data/commerceos.db
# For PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///data/commerceos.db
